# Copy this file to .env for local configuration. Never commit real secrets.
# Keep real outbound email disabled for demos and research.
ALLOW_REAL_SEND=false
IKNA_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
IKNA_ADMIN_PASSWORD=change-this-before-first-run
ALLOWED_EMAIL_DOMAINS=example.com,example.org,example.net,test.local
# SMTP values intentionally omitted; real sending remains disabled by default.
